// Prisma schema
// Run: pnpm dlx prisma generate && pnpm dlx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  threads   Thread[]
}

model Thread {
  id        String   @id @default(uuid())
  title     String
  isPinned  Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MCPServer {
  id        String            @id @default(uuid())
  name      String            @unique
  type      MCPServerType
  enabled   Boolean           @default(true)
  command   String?
  args      Json?
  env       Json?
  url       String?
  headers   Json?
  requiresAuth  Boolean?      @default(false)
  authTokens    Json?
  clientInfo    Json?
  codeVerifier  String?
  oauthStatus   String?       @default("UNKNOWN")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum MCPServerType {
  stdio
  http
}